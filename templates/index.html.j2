<!doctype html>
<html lang="en">

<head>
  {% include "head_common.html.j2" %}
  <link href="/atom.xml" type="application/atom+xml" rel="alternate" title="Sitewide atom feed">
</head>

<body>
  <header>
    {% include "navbar.html.j2" %}
  </header>

  <main>
    {%- for blog_post in blog_posts %}
    <article>
      <time datetime="{{ blog_post.publication_dt| date(format="%Y-%m-%dT%H:%M:%S%:z") }}">{{ blog_post.publication_dt | date(format="%B %d, %Y") }}</time>
      <a href="/{{ blog_post.relative_path }}">{{ blog_post.title }}</a>
    </article>
    {%- endfor %}
  </main>

  {% include "footer.html.j2" %}
</body>

</html>